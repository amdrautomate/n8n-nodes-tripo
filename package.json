{
  "name": "@amdrautomate/n8n-nodes-tripo",
  "version": "0.1.1",
  "description": "n8n community node for Tripo (Tripo3D): generate 3D models from text, images or multiview photos, texture, convert, retopologize, segment, rig and animate them, generate images and multiviews, and poll tasks with the Tripo API v3",
  "license": "MIT",
  "homepage": "https://github.com/amdrautomate/n8n-nodes-tripo",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "tripo",
    "tripo3d",
    "3d generation",
    "text to 3d",
    "image to 3d",
    "glb",
    "rigging",
    "retopology"
  ],
  "author": {
    "name": "Alicia Graham",
    "email": "hello@amdrautomate.ai",
    "url": "https://amdrautomate.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amdrautomate/n8n-nodes-tripo.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TripoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Tripo/Tripo.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/amdrautomate/n8n-nodes-tripo/issues"
  },
  "engines": {
    "node": ">=20.15"
  }
}
